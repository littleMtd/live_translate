{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Translate",
  "version": "0.1.0",
  "identifier": "com.livetranslate.app",
  "build": {
    "frontendDist": "../src-frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../src-frontend run dev",
    "beforeBuildCommand": "npm --prefix ../src-frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Live Translate Dashboard",
        "width": 960,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
